---
import { Image } from 'astro:assets';
import feature1 from '../assets/images/feature1.jpg';
import feature2 from '../assets/images/feature2.jpg';
import feature3 from '../assets/images/feature3.jpg';
import feature4 from '../assets/images/feature4.jpg';
import CheckArrowIcon from '../assets/icons/CheckArrowIcon.astro';
---

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700;1,800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

<section class="features-section w-full pt-24 md:pt-[12vw] lg:pt-16" id="features">
  <div style="position:relative;z-index:1;">
    <div class="mx-auto flex w-11/12 flex-wrap items-center md:pl-4 xl:w-[81.25rem] xl:pr-16 xl:pl-16 2xl:w-[90.625rem]">

      <!-- LEFT: Text -->
      <div class="mb-12 w-full lg:mb-0 lg:w-1/2">
        <div class="lg:w-unset mx-auto w-11/12 sm:w-4/5 md:w-3/4 lg:mx-auto">

          <!-- Eyebrow — left se aaye -->
          <div class="features-eyebrow" data-gsap="fade-left">
            <span class="features-eyebrow__dot"></span>
            Since 1996
            <span class="features-eyebrow__dot"></span>
          </div>

          <!-- Heading — words split ho ke aayein -->
          <h2 class="features-heading" data-split>
            <span class="heading-white">Company </span>
            <span class="heading-gold">Introduction</span>
          </h2>

          <!-- Body — upar se aaye -->
          <p class="features-body" data-gsap="fade-up">
            Umar &amp; Company is working since 1996 and has successfully completed many projects
            with national and international companies and factories. We deals in Mechanical Services,
            Labor Services, M.S &amp; S.S. Material Suppliers, Insulation Material Suppliers,
            Factory work, Boiler Operating, Loading &amp; Unloading, Packing, Supply Lifter,
            and Excavators. Ducting, Hot &amp; Cool Pipe Line Insulation, All aspects of Quality Control.
          </p>

          <!-- List — stagger ke saath aaye -->
          <ul class="features-list" data-gsap="stagger">
            <li data-gsap-item><CheckArrowIcon /><span>Residential &amp; Commercial Construction</span></li>
            <li data-gsap-item><CheckArrowIcon /><span>Expert Project Management</span></li>
            <li data-gsap-item><CheckArrowIcon /><span>Quality Materials &amp; Skilled Workforce</span></li>
          </ul>

        </div>
      </div>

      <!-- RIGHT: Images — scale in -->
      <div class="mx-auto flex w-3/4 flex-wrap justify-center sm:pr-8 lg:-mx-4 lg:w-1/2 lg:pt-10 lg:pl-4 xl:px-8">
        <div class="mb-8 w-full px-2 sm:w-1/2 lg:mb-0 lg:px-0">
          <div class="mb-4 rounded py-3 pr-2 pl-3">
            <div class="relative" data-gsap="scale-in">
              <Image src={feature1} alt="Feature image 1"
                class="sm:mx-unset image-border mx-auto rounded-xl features-img"
                loading="eager" decoding="sync" />
            </div>
          </div>
          <div class="rounded py-3 pr-2 pl-3">
            <div class="relative" data-gsap="scale-in">
              <Image src={feature2} alt="Feature image 2"
                class="sm:mx-unset image-border mx-auto rounded-xl features-img"
                loading="eager" decoding="sync" />
            </div>
          </div>
        </div>
        <div class="hidden w-1/2 px-2 pt-12 sm:inline-block lg:mt-20 lg:pt-0">
          <div class="mb-4 rounded-lg py-3 pr-2 pl-3">
            <div class="relative" data-gsap="scale-in">
              <Image src={feature3} alt="Feature image 3"
                class="image-border rounded-xl features-img"
                loading="eager" decoding="sync" />
            </div>
          </div>
          <div class="rounded-lg py-3 pr-2 pl-3">
            <div class="relative" data-gsap="scale-in">
              <Image src={feature4} alt="Feature image 4"
                class="image-border rounded-xl features-img"
                loading="eager" decoding="sync" />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .features-section { position: relative; background: #17181b; overflow: hidden; }

  .features-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'DM Sans', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.28em; text-transform: uppercase; color: #60a5fa;
    border: 1px solid rgba(96,165,250,0.25); border-radius: 999px;
    padding: 6px 18px; background: rgba(96,165,250,0.06); margin-bottom: 1.25rem;
  }
  .features-eyebrow__dot {
    display: inline-block; width: 5px; height: 5px;
    border-radius: 50%; background: #60a5fa; opacity: 0.7;
  }

  .features-heading {
    font-family: 'Playfair Display', serif; font-weight: 800;
    font-size: clamp(2.8rem, 6vw, 5.5rem); line-height: 1.08;
    letter-spacing: -0.01em; margin: 0 0 1.5rem;
  }
  .heading-white { color: #ffffff; }
  .heading-gold  { color: #e09a31; font-style: italic; }

  .features-body {
    font-family: 'DM Sans', sans-serif; color: #94a3b8;
    font-size: 1.05rem; line-height: 1.85; margin-bottom: 2rem; max-width: 520px;
  }

  .features-list {
    list-style: none; padding: 0; margin: 0 0 1.5rem;
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .features-list li {
    display: flex; align-items: center; gap: 10px;
    font-family: 'DM Sans', sans-serif; font-size: 1rem;
    font-weight: 500; color: #e2e8f0;
  }

  .features-img {
    border: 1px solid rgba(96,165,250,0.15);
    transition: border-color 0.3s, transform 0.4s cubic-bezier(.22,1,.36,1);
  }
  .features-img:hover { border-color: rgba(96,165,250,0.4); transform: scale(1.02); }
</style>