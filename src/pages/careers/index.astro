---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollUpButton from '../../components/ScrollUpButton.astro';

const openings = [
  {
    title: "Mechanical Technician",
    type: "Full-Time",
    location: "Lahore / On-Site",
    dept: "Mechanical",
    desc: "Perform plant installation, pipe fitting, welding, and mechanical assembly on industrial project sites across Pakistan.",
    skills: ["Pipe Fitting", "Welding (MIG/TIG)", "Plant Installation", "Safety Compliance"],
  },
  {
    title: "Insulation Supervisor",
    type: "Full-Time",
    location: "Punjab-wide",
    dept: "Insulation",
    desc: "Supervise teams carrying out steam line, chilled water, and HVAC duct insulation with GI/aluminium cladding.",
    skills: ["Pipe Insulation", "Cladding", "Team Leadership", "QC Inspection"],
  },
  {
    title: "Site Safety Officer (HSE)",
    type: "Full-Time",
    location: "Multiple Sites",
    dept: "Safety",
    desc: "Enforce HSE policies, conduct risk assessments, deliver safety inductions, and ensure zero-incident operations.",
    skills: ["Risk Assessment", "PPE Management", "Method Statements", "Incident Reporting"],
  },
  {
    title: "Structural Steel Erector",
    type: "Contract",
    location: "Faisalabad / Sheikhupura",
    dept: "Structural",
    desc: "Carry out structural steel erection, bolting, and alignment on industrial plant and manufacturing facility projects.",
    skills: ["Steel Erection", "Rigging", "Blueprint Reading", "Heavy Lifting"],
  },
  {
    title: "Material Store Keeper",
    type: "Full-Time",
    location: "Lahore Head Office",
    dept: "Supply",
    desc: "Manage inventory of SS/GI pipes, insulation materials, and equipment. Handle records, dispatch, and stock control.",
    skills: ["Inventory Management", "MS Excel", "Stock Control", "Documentation"],
  },
  {
    title: "Labour Supervisor",
    type: "Full-Time",
    location: "On-Site (Various)",
    dept: "Labor",
    desc: "Coordinate and supervise daily labour operations including loading, unloading, packing, and on-site shifting tasks.",
    skills: ["Team Management", "Site Coordination", "Safety Awareness", "Reporting"],
  },
];

const perks = [
  { icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`, title: "Safe Work Environment", desc: "Full PPE provided. Zero-compromise on worker safety across all our sites." },
  { icon: `<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>`, title: "Team Culture", desc: "Work alongside experienced professionals who take pride in every project." },
  { icon: `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`, title: "Skill Development", desc: "On-the-job training, certifications, and real-world project exposure." },
  { icon: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>`, title: "Timely Salary", desc: "Competitive pay, paid on time, every month — no delays, no excuses." },
];

const deptColors: Record<string, string> = {
  Mechanical: "#b87716",
  Insulation: "#d4a000",
  Safety:     "#10b981",
  Structural: "#c49a1a",
  Supply:     "#e8b84b",
  Labor:      "#f0a500",
};
---

<Layout title="Careers - Umar & Company" description="Join Umar & Company — industrial careers in Pakistan">
  <Navbar />

  <!-- ══ HERO ══ -->
  <section class="careers-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="hero-badge"><span class="bdot"></span> Join Our Team <span class="bdot"></span></span>
      <h1 class="hero-title">Build Your Career<br/>with <em>Umar &amp; Company</em></h1>
      <p class="hero-sub">We are always looking for skilled, hardworking individuals to join Pakistan's trusted industrial services team. Explore open positions below.</p>
      <div class="hero-meta">
        <span class="hmeta"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Lahore & Punjab-wide</span>
        <span class="hmeta"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg> {openings.length} Open Positions</span>
        <span class="hmeta"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Since 1990</span>
      </div>
    </div>
  </section>

  <!-- ══ WHY JOIN US ══ -->
  <section class="section-pad">
    <div class="content-container">
      <div class="sec-header">
        <span class="sec-label">+ WHY UMAR & COMPANY +</span>
        <h2 class="sec-title">Why Work <em>With Us?</em></h2>
      </div>
      <div class="perks-grid">
        {perks.map(p => (
          <div class="perk-card">
            <div class="perk-icon">
              <svg width="22" height="22" fill="none" stroke="#b87716" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"
                set:html={p.icon}></svg>
            </div>
            <h3 class="perk-title">{p.title}</h3>
            <p class="perk-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ OPENINGS ══ -->
  <section class="section-pad bg-alt">
    <div class="content-container">
      <div class="sec-header">
        <span class="sec-label">+ OPEN POSITIONS +</span>
        <h2 class="sec-title">Current <em>Openings</em></h2>
        <p class="sec-sub">All roles are based in Punjab. Send your CV to apply — details at the bottom.</p>
      </div>
      <div class="jobs-list">
        {openings.map((job) => (
          <div class="job-card" style={`--jc: ${deptColors[job.dept] ?? '#b87716'}`}>
            <div class="job-top">
              <div class="job-left">
                <div class="job-dept">{job.dept}</div>
                <h3 class="job-title">{job.title}</h3>
                <div class="job-meta-row">
                  <span class="jmeta">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {job.location}
                  </span>
                  <span class="jtype">{job.type}</span>
                </div>
              </div>
              <a href="#apply" class="apply-btn">
                Apply Now
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
            <p class="job-desc">{job.desc}</p>
            <div class="job-skills">
              {job.skills.map(s => <span class="skill-tag">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ APPLY CTA ══ -->
  <section class="apply-section" id="apply">
    <div class="content-container apply-inner">
      <div class="apply-text">
        <span class="sec-label">+ HOW TO APPLY +</span>
        <h2 class="sec-title">Interested? <em>Send Your CV</em></h2>
        <p class="body-text">Send your CV with the job title in the subject line. We review all applications and will contact shortlisted candidates within 5–7 working days.</p>
        <div class="apply-contacts">
          <a href="mailto:careers@umarcompany.com" class="apply-link">
            <svg width="18" height="18" fill="none" stroke="#b87716" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            careers@umarcompany.com
          </a>
          <a href="tel:+923001234567" class="apply-link">
            <svg width="18" height="18" fill="none" stroke="#b87716" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.18 1.18 2 2 0 012.18 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.18 6.18l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            +92 300 123 4567
          </a>
        </div>
      </div>
      <div class="apply-card">
        <h3 class="ac-title">Quick Apply</h3>
        <div class="ac-field"><label>Full Name</label><input type="text" placeholder="Muhammad Ali"/></div>
        <div class="ac-field"><label>Phone Number</label><input type="tel" placeholder="+92 300 0000000"/></div>
        <div class="ac-field"><label>Position Applying For</label>
          <select>
            <option value="">Select a position</option>
            {openings.map(j => <option>{j.title}</option>)}
          </select>
        </div>
        <div class="ac-field"><label>Message (Optional)</label><textarea rows="3" placeholder="Tell us about your experience..."></textarea></div>
        <button class="ac-submit">Submit Application</button>
        <p class="ac-note">We will contact you within 5–7 working days.</p>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  :root { --gold:#b87716; --gold2:#d4a000; --page:#17181b; --card:#1e1f24; --border:rgba(255,255,255,0.07); }

  /* Hero */
  .careers-hero { background:var(--page); padding:9rem 1.5rem 6rem; text-align:center; position:relative; overflow:hidden; }
  .hero-glow { position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(184,119,22,0.13) 0%,transparent 65%);pointer-events:none; }
  .hero-inner { position:relative;z-index:1;max-width:720px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:1.25rem; }
  .hero-badge { display:inline-flex;align-items:center;gap:10px;font-size:0.7rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(184,119,22,0.3);border-radius:999px;padding:7px 18px;background:rgba(184,119,22,0.07); }
  .bdot { display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--gold);animation:bp 1.8s ease infinite; }
  @keyframes bp { 0%,100%{opacity:.8;transform:scale(1)} 50%{opacity:.3;transform:scale(1.5)} }
  .hero-title { font-size:clamp(2.4rem,6vw,5rem);font-weight:800;line-height:1.1;letter-spacing:-0.02em;color:#fff;margin:0; }
  .hero-title em { color:var(--gold);font-style:italic;font-family:'Georgia',serif; }
  .hero-sub { max-width:540px;color:rgba(255,255,255,0.48);font-size:clamp(0.9rem,1.5vw,1rem);line-height:1.8;margin:0; }
  .hero-meta { display:flex;flex-wrap:wrap;gap:1rem;justify-content:center; }
  .hmeta { display:inline-flex;align-items:center;gap:6px;font-size:0.78rem;color:rgba(255,255,255,0.40);background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:999px;padding:6px 14px; }

  /* Sections */
  .section-pad { padding:5.5rem 1.5rem;background:var(--page); }
  .bg-alt { background:#15161a; }
  .sec-header { text-align:center;margin-bottom:3rem; }
  .sec-label { display:block;font-size:0.68rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--gold);margin-bottom:0.75rem; }
  .sec-title { font-size:clamp(1.9rem,4vw,3rem);font-weight:800;line-height:1.15;color:#f1f5f9;letter-spacing:-0.02em;margin:0 0 1rem; }
  .sec-title em { color:var(--gold);font-style:italic;font-family:'Georgia',serif; }
  .sec-sub { color:rgba(255,255,255,0.42);font-size:0.9rem;line-height:1.75;max-width:500px;margin:0 auto; }
  .body-text { font-size:0.9rem;color:rgba(255,255,255,0.50);line-height:1.85;margin:0 0 1rem; }

  /* Perks */
  .perks-grid { display:grid;grid-template-columns:1fr;gap:1rem; }
  @media(min-width:640px){.perks-grid{grid-template-columns:repeat(2,1fr);}}
  @media(min-width:1024px){.perks-grid{grid-template-columns:repeat(4,1fr);}}
  .perk-card { background:var(--card);border:1px solid var(--border);border-radius:16px;padding:1.75rem;transition:border-color 0.3s,transform 0.3s; }
  .perk-card:hover { border-color:rgba(184,119,22,0.35);transform:translateY(-3px); }
  .perk-icon { width:48px;height:48px;border-radius:12px;background:rgba(184,119,22,0.10);border:1px solid rgba(184,119,22,0.22);display:flex;align-items:center;justify-content:center;margin-bottom:1rem; }
  .perk-title { font-size:0.95rem;font-weight:700;color:#f1f5f9;margin:0 0 0.5rem; }
  .perk-desc { font-size:0.8rem;color:rgba(255,255,255,0.45);line-height:1.7;margin:0; }

  /* Jobs */
  .jobs-list { display:flex;flex-direction:column;gap:1rem; }
  .job-card { background:var(--card);border:1px solid var(--border);border-left:3px solid var(--jc);border-radius:16px;padding:1.75rem;transition:border-color 0.3s,transform 0.3s,box-shadow 0.3s; }
  .job-card:hover { border-color:color-mix(in srgb,var(--jc) 50%,rgba(255,255,255,0.07));transform:translateX(4px);box-shadow:0 8px 30px rgba(0,0,0,0.3); }
  .job-top { display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:0.875rem; }
  .job-left { flex:1;min-width:0; }
  .job-dept { font-size:0.62rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--jc);background:color-mix(in srgb,var(--jc) 12%,transparent);border:1px solid color-mix(in srgb,var(--jc) 28%,transparent);border-radius:999px;padding:3px 10px;display:inline-block;margin-bottom:0.5rem; }
  .job-title { font-size:1.1rem;font-weight:800;color:#f1f5f9;margin:0 0 0.5rem;line-height:1.3; }
  .job-meta-row { display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem; }
  .jmeta { display:inline-flex;align-items:center;gap:5px;font-size:0.72rem;color:rgba(255,255,255,0.38); }
  .jtype { font-size:0.68rem;font-weight:600;padding:3px 10px;border-radius:999px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.10);color:rgba(255,255,255,0.40); }
  .apply-btn { flex-shrink:0;display:inline-flex;align-items:center;gap:6px;padding:9px 20px;border-radius:999px;background:color-mix(in srgb,var(--jc) 14%,transparent);border:1px solid color-mix(in srgb,var(--jc) 32%,transparent);color:var(--jc);font-size:0.78rem;font-weight:700;text-decoration:none;transition:background 0.25s,color 0.25s;white-space:nowrap; }
  .apply-btn:hover { background:var(--jc);color:#0d0e11; }
  .job-desc { font-size:0.82rem;color:rgba(255,255,255,0.45);line-height:1.75;margin:0 0 1rem; }
  .job-skills { display:flex;flex-wrap:wrap;gap:0.4rem; }
  .skill-tag { font-size:0.65rem;font-weight:600;letter-spacing:0.05em;padding:3px 10px;border-radius:999px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.09);color:rgba(255,255,255,0.38); }

  /* Apply section */
  .apply-section { background:var(--page);padding:5.5rem 1.5rem; }
  .apply-inner { display:grid;grid-template-columns:1fr;gap:3.5rem;align-items:start; }
  @media(min-width:900px){.apply-inner{grid-template-columns:1fr 1fr;gap:5rem;}}
  .apply-contacts { display:flex;flex-direction:column;gap:0.75rem;margin-top:1.5rem; }
  .apply-link { display:inline-flex;align-items:center;gap:10px;font-size:0.9rem;font-weight:600;color:rgba(255,255,255,0.55);text-decoration:none;transition:color 0.25s; }
  .apply-link:hover { color:var(--gold); }

  /* Quick apply card */
  .apply-card { background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2rem;display:flex;flex-direction:column;gap:1.125rem; }
  .ac-title { font-size:1.1rem;font-weight:800;color:#f1f5f9;margin:0; }
  .ac-field { display:flex;flex-direction:column;gap:0.4rem; }
  .ac-field label { font-size:0.72rem;font-weight:600;color:rgba(255,255,255,0.45);letter-spacing:0.05em; }
  .ac-field input,.ac-field select,.ac-field textarea {
    background:#131420;border:1px solid rgba(255,255,255,0.10);border-radius:10px;
    padding:10px 14px;color:#f1f5f9;font-size:0.85rem;outline:none;resize:none;
    transition:border-color 0.25s;font-family:inherit;width:100%;box-sizing:border-box;
  }
  .ac-field input:focus,.ac-field select:focus,.ac-field textarea:focus { border-color:rgba(184,119,22,0.50); }
  .ac-field select option { background:#1e1f24; }
  .ac-submit { background:var(--gold);color:#0d0e11;border:none;border-radius:999px;padding:12px 28px;font-size:0.875rem;font-weight:800;cursor:pointer;transition:background 0.25s,transform 0.25s;box-shadow:0 4px 20px rgba(184,119,22,0.35); }
  .ac-submit:hover { background:var(--gold2);transform:translateY(-2px); }
  .ac-note { font-size:0.72rem;color:rgba(255,255,255,0.28);margin:0;text-align:center; }
</style>