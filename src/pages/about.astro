---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';

const values = [
  { title: "Professionalism", desc: "We uphold the highest standards of conduct on every project, from planning to final delivery." },
  { title: "Integrity",       desc: "Honest communication and transparent dealings with every client, partner, and team member." },
  { title: "Safety First",    desc: "Zero-compromise on HSE practices — every worker goes home safe, every single day." },
  { title: "Quality",         desc: "We deliver work that meets or exceeds international standards, every time, without exception." },
];

const commitments = [
  { icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`, label: "Safety Compliance",   desc: "Full HSE compliance on all sites and operations." },
  { icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,  label: "On-Time Delivery",    desc: "Projects delivered on schedule, every time." },
  { icon: `<path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>`, label: "Skilled Workforce",   desc: "Trained, certified professionals across all trades." },
  { icon: `<polyline points="20 6 9 17 4 12"/>`, label: "Quality Assurance",  desc: "Rigorous quality checks at every project stage." },
  { icon: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`, label: "Modern Equipment",    desc: "Latest tools and machinery for precision work." },
  { icon: `<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>`, label: "Client Partnership",  desc: "Long-term relationships built on trust and results." },
];

const stats = [
  { value: "1990", label: "Est. Year" },
  { value: "34+",  label: "Years Active" },
  { value: "50+",  label: "Projects Done" },
  { value: "14+",  label: "Major Clients" },
];
---

<Layout title="About - Umar & Company" description="About Umar & Company — Industrial services since 1990">
  <Navbar />

  <!-- ══ HERO ══════════════════════════════════════════════ -->
  <section class="about-hero">
    <div class="hero-content">
      <span class="hero-badge"><span class="bdot"></span> About Us <span class="bdot"></span></span>
      <h1 class="hero-title">
        Umar &amp; <em>Company</em>
      </h1>
      <p class="hero-sub">
        Established in 1990 — Pakistan's trusted partner for mechanical services,
        industrial insulation, material supply, and plant installation.
      </p>
    </div>
    <!-- Diagonal slash divider -->
    <div class="hero-slash" aria-hidden="true"></div>
  </section>

  <!-- ══ STATS STRIP ════════════════════════════════════════ -->
  <div class="stats-strip">
    <div class="content-container stats-inner">
      {stats.map(s => (
        <div class="stat-cell">
          <span class="stat-val">{s.value}</span>
          <span class="stat-lbl">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ══ COMPANY INTRO ══════════════════════════════════════ -->
  <section class="section-pad">
    <div class="content-container split-grid">
      <!-- Text -->
      <div class="split-text">
        <span class="section-label">+ COMPANY INTRODUCTION +</span>
        <h2 class="section-title">Who We <em>Are</em></h2>
        <p class="body-text">
          Umar &amp; Company has been operating since <strong class="gold">1990</strong>, successfully
          completing projects with national and international companies and factories across Pakistan.
        </p>
        <p class="body-text">
          We specialise in <strong class="gold">Mechanical Services</strong>, Labour Services,
          M.S &amp; S.S. Material Supply, Insulation Material Supply, Factory Work, Boiler
          Operating, Loading &amp; Unloading, Packing, Supply Lifting, and Excavation.
          We also provide Ducting, Hot &amp; Cool Pipe Line Insulation, and all aspects of
          Quality Control.
        </p>
        <ul class="check-list">
          {["Residential & Commercial Industrial Works",
            "Expert Project Management",
            "Quality Materials & Skilled Workforce",
            "Full HSE Compliance on All Sites"].map(item => (
            <li>
              <span class="check-icon">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#b87716" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <!-- Image mosaic -->
      <div class="split-imgs">
        <div class="img-main">
          <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&q=80" alt="Industrial site" loading="lazy"/>
          <div class="img-badge">Est. 1990</div>
        </div>
        <div class="img-small">
          <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=400&q=80" alt="Mechanical work" loading="lazy"/>
        </div>
        <div class="img-small">
          <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=400&q=80" alt="Welding work" loading="lazy"/>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ MISSION & VISION ═══════════════════════════════════ -->
  <section class="section-pad bg-alt">
    <div class="content-container">
      <div class="mv-grid">
        <!-- Mission -->
        <div class="mv-card">
          <div class="mv-icon">
            <svg width="26" height="26" fill="none" stroke="#b87716" stroke-width="1.8" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
          </div>
          <span class="mv-label">Our Mission</span>
          <h3 class="mv-title">Delivering Excellence<br/><em>Every Project</em></h3>
          <p class="mv-desc">
            Our mission is to deliver construction and industrial excellence that stands the test of
            time. We build structures not just with steel and concrete, but with integrity and craft.
            Every project we undertake reflects our commitment to safety, quality, and client satisfaction.
          </p>
          <div class="mv-accent-bar"></div>
        </div>
        <!-- Vision -->
        <div class="mv-card">
          <div class="mv-icon">
            <svg width="26" height="26" fill="none" stroke="#b87716" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <span class="mv-label">Our Vision</span>
          <h3 class="mv-title">Pakistan's Most<br/><em>Trusted Partner</em></h3>
          <p class="mv-desc">
            We aspire to be the most trusted industrial services company in Pakistan — known for
            precision installations, flawless delivery, and workforce development. We strive to make
            continuous improvements in everything we do to better serve our clients.
          </p>
          <div class="mv-accent-bar"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ VALUES ═════════════════════════════════════════════ -->
  <section class="section-pad">
    <div class="content-container">
      <div class="sec-header">
        <span class="section-label">+ WHAT DRIVES US +</span>
        <h2 class="section-title">Our Core <em>Values</em></h2>
      </div>
      <div class="values-grid">
        {values.map((v, i) => (
          <div class="value-card">
            <div class="value-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="value-line"></div>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-desc">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ GOALS ══════════════════════════════════════════════ -->
  <section class="section-pad bg-alt">
    <div class="content-container split-grid reverse">
      <div class="split-text">
        <span class="section-label">+ WHERE WE'RE HEADED +</span>
        <h2 class="section-title">Our <em>Goals</em></h2>
        <p class="body-text">
          Our primary goal is to build long-term partnerships with Pakistan's leading industrial
          and manufacturing companies. We aim to expand our service footprint, grow our
          certified workforce, and set new benchmarks for quality and safety in every sector we serve.
        </p>
        <ul class="check-list">
          {["Expand operations across all major industrial cities",
            "Grow certified workforce to 500+ professionals",
            "Achieve ISO certification for quality management",
            "Deliver every project on time and within budget"].map(item => (
            <li>
              <span class="check-icon">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#b87716" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="goal-visual">
        <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=700&q=80" alt="Our goals" loading="lazy"/>
        <div class="goal-overlay"></div>
        <div class="goal-stat-box">
          <span class="gsb-val">100%</span>
          <span class="gsb-lbl">Client Satisfaction</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ COMMITMENTS ═════════════════════════════════════════ -->
  <section class="section-pad">
    <div class="content-container">
      <div class="sec-header">
        <span class="section-label">+ OUR PROMISE +</span>
        <h2 class="section-title">Our <em>Commitments</em></h2>
        <p class="sec-sub">Every project backed by six core commitments that define how we work.</p>
      </div>
      <div class="commit-grid">
        {commitments.map(c => (
          <div class="commit-card">
            <div class="commit-icon">
              <svg width="22" height="22" fill="none" stroke="#b87716" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"
                set:html={c.icon}></svg>
            </div>
            <h4 class="commit-title">{c.label}</h4>
            <p class="commit-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ QUALITY ═════════════════════════════════════════════ -->
  <section class="section-pad bg-alt">
    <div class="content-container split-grid">
      <div class="split-text">
        <span class="section-label">+ APPROACH TO QUALITY +</span>
        <h2 class="section-title">Our <em>Quality</em><br/>Standards</h2>
        <p class="body-text">
          Quality at Umar &amp; Company is not a department — it is a culture. Our team follows
          strict quality control protocols at every stage of every project. We use internationally
          sourced materials, employ certified technicians, and conduct systematic inspections
          to ensure all deliverables meet or exceed client expectations.
        </p>
        <p class="body-text">
          We are continuously upgrading our processes, equipment, and training to deliver
          better outcomes on every project we take on.
        </p>
        <div class="quality-badges">
          {["Certified Materials", "Skilled Technicians", "Systematic Inspections", "International Standards"].map(b => (
            <span class="qbadge">{b}</span>
          ))}
        </div>
      </div>
      <div class="quality-visual">
        <div class="qv-card qv-top">
          <svg width="32" height="32" fill="none" stroke="#b87716" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Quality<br/>Guaranteed</span>
        </div>
        <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&q=80" alt="Quality work" loading="lazy"/>
        <div class="qv-overlay"></div>
      </div>
    </div>
  </section>

  <!-- ══ REGISTRATIONS ══════════════════════════════════════ -->
  <section class="section-pad">
    <div class="content-container">
      <div class="sec-header">
        <span class="section-label">+ OFFICIAL CREDENTIALS +</span>
        <h2 class="section-title">Tax &amp; Year <em>Registrations</em></h2>
        <p class="sec-sub">Umar &amp; Company is a fully registered, tax-compliant business operating under all applicable Pakistani regulations.</p>
      </div>
      <div class="reg-grid">
        {[
          { abbr: "FBR",  name: "Federal Board of Revenue",  detail: "National Tax Number (NTN) registered",  type: "FEDERAL" },
          { abbr: "PRA",  name: "Punjab Revenue Authority",   detail: "Sales Tax on Services registered",       type: "PROVINCIAL" },
          { abbr: "EOBI", name: "Employees Old-Age Benefits", detail: "EOBI registered employer",               type: "LABOUR" },
          { abbr: "SESSI",name: "Social Security Institution", detail: "Employee social security compliant",    type: "WELFARE" },
        ].map(r => (
          <div class="reg-card">
            <div class="reg-top">
              <span class="reg-type">{r.type}</span>
            </div>
            <div class="reg-abbr">{r.abbr}</div>
            <h4 class="reg-name">{r.name}</h4>
            <p class="reg-detail">{r.detail}</p>
            <div class="reg-verified">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Verified &amp; Active
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ BOTTOM CTA ═════════════════════════════════════════ -->
  <section class="cta-section">
    <div class="content-container cta-inner">
      <h2 class="cta-title">Ready to Work with<br/><em>Umar &amp; Company?</em></h2>
      <p class="cta-sub">Get a free consultation for your next industrial project.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn-gold">
          Contact Us
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/services" class="btn-outline">View Services</a>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollUpButton />
</Layout>

<style>
  /* ── Tokens ── */
  :root {
    --gold: #b87716;
    --gold2: #d4a000;
    --page: #17181b;
    --card: #1e1f24;
    --border: rgba(255,255,255,0.07);
  }

  /* ── Hero ── */
  .about-hero {
    background: var(--page);
    padding: 9rem 1.5rem 7rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .about-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(184,119,22,0.12) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-content { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold); border: 1px solid rgba(184,119,22,0.30); border-radius: 999px;
    padding: 7px 18px; background: rgba(184,119,22,0.07);
  }
  .bdot {
    display: inline-block; width: 5px; height: 5px; border-radius: 50%;
    background: var(--gold); animation: bp 1.8s ease infinite;
  }
  @keyframes bp { 0%,100%{opacity:.8;transform:scale(1)} 50%{opacity:.3;transform:scale(1.5)} }
  .hero-title {
    font-size: clamp(3rem, 7vw, 6rem); font-weight: 800;
    line-height: 1.1; letter-spacing: -0.025em; color: #fff; margin: 1rem 0 0;
  }
  .hero-title em { color: var(--gold); font-style: italic; font-family: 'Georgia', serif; }
  .hero-sub {
    margin-top: 1.25rem; color: rgba(255,255,255,0.48);
    font-size: clamp(0.9rem, 1.5vw, 1.05rem); line-height: 1.8; max-width: 520px; margin-inline: auto;
  }
  .hero-slash {
    position: absolute; bottom: -1px; left: 0; right: 0; height: 60px;
    background: var(--page);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }

  /* ── Stats strip ── */
  .stats-strip {
    background: var(--card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .stats-inner {
    display: grid; grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) { .stats-inner { grid-template-columns: repeat(4, 1fr); } }
  .stat-cell {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; padding: 1.75rem 1rem;
    border-right: 1px solid var(--border);
    transition: background 0.3s;
  }
  .stat-cell:last-child { border-right: none; }
  .stat-cell:hover { background: rgba(184,119,22,0.04); }
  .stat-val { font-size: 2rem; font-weight: 800; color: var(--gold); line-height: 1; }
  .stat-lbl { font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.35); }

  /* ── Sections ── */
  .section-pad { padding: 5.5rem 1.5rem; background: var(--page); }
  .bg-alt { background: #15161a; }

  /* ── Split grid ── */
  .split-grid {
    display: grid; grid-template-columns: 1fr; gap: 3.5rem; align-items: center;
  }
  @media (min-width: 900px) {
    .split-grid { grid-template-columns: 1fr 1fr; gap: 5rem; }
    .split-grid.reverse .split-text { order: 2; }
    .split-grid.reverse .goal-visual { order: 1; }
  }

  /* Section labels / titles */
  .section-label {
    display: block; font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 800;
    line-height: 1.15; color: #f1f5f9; letter-spacing: -0.02em; margin: 0 0 1.25rem;
  }
  .section-title em { color: var(--gold); font-style: italic; font-family: 'Georgia', serif; }
  .sec-header { text-align: center; margin-bottom: 3.5rem; }
  .sec-sub { color: rgba(255,255,255,0.45); font-size: 0.95rem; line-height: 1.75; max-width: 520px; margin: 0.75rem auto 0; }

  .body-text { font-size: 0.9rem; color: rgba(255,255,255,0.52); line-height: 1.85; margin: 0 0 1rem; }
  .gold { color: var(--gold); font-weight: 700; }

  /* Checklist */
  .check-list { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .check-list li { display: flex; align-items: center; gap: 0.625rem; font-size: 0.87rem; color: rgba(255,255,255,0.65); }
  .check-icon {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(184,119,22,0.12); border: 1px solid rgba(184,119,22,0.28);
  }

  /* ── Image mosaic ── */
  .split-imgs {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 200px 160px; gap: 0.75rem;
  }
  .img-main {
    grid-column: 1; grid-row: 1 / 3; border-radius: 16px; overflow: hidden;
    position: relative; border: 1px solid var(--border);
  }
  .img-main img { width: 100%; height: 100%; object-fit: cover; }
  .img-badge {
    position: absolute; bottom: 14px; left: 14px;
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em;
    background: var(--gold); color: #0d0e11; padding: 5px 12px; border-radius: 999px;
  }
  .img-small { border-radius: 14px; overflow: hidden; border: 1px solid var(--border); }
  .img-small img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Mission / Vision ── */
  .mv-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .mv-grid { grid-template-columns: 1fr 1fr; } }
  .mv-card {
    background: var(--page); border: 1px solid var(--border); border-radius: 20px;
    padding: 2.5rem; position: relative; overflow: hidden;
    transition: border-color 0.3s, transform 0.3s;
  }
  .mv-card:hover { border-color: rgba(184,119,22,0.35); transform: translateY(-4px); }
  .mv-icon {
    width: 52px; height: 52px; border-radius: 13px;
    background: rgba(184,119,22,0.10); border: 1px solid rgba(184,119,22,0.25);
    display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;
  }
  .mv-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
  .mv-title {
    font-size: 1.6rem; font-weight: 800; color: #f1f5f9; line-height: 1.2;
    letter-spacing: -0.015em; margin: 0.5rem 0 1rem;
  }
  .mv-title em { color: var(--gold); font-style: italic; font-family: 'Georgia', serif; }
  .mv-desc { font-size: 0.87rem; color: rgba(255,255,255,0.50); line-height: 1.8; margin: 0; }
  .mv-accent-bar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(to right, var(--gold), transparent);
    opacity: 0.7;
  }

  /* ── Values ── */
  .values-grid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); border-radius: 18px; overflow: hidden; }
  @media (min-width: 768px) { .values-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .values-grid { grid-template-columns: repeat(4, 1fr); } }
  .value-card {
    background: var(--card); padding: 2rem 1.75rem;
    transition: background 0.3s;
  }
  .value-card:hover { background: #22232a; }
  .value-num { font-family: monospace; font-size: 2.5rem; font-weight: 900; color: rgba(184,119,22,0.18); line-height: 1; margin-bottom: 0.75rem; }
  .value-line { width: 36px; height: 3px; background: var(--gold); border-radius: 2px; margin-bottom: 1rem; opacity: 0.8; }
  .value-title { font-size: 1.05rem; font-weight: 800; color: #f1f5f9; margin: 0 0 0.6rem; }
  .value-desc { font-size: 0.82rem; color: rgba(255,255,255,0.45); line-height: 1.75; margin: 0; }

  /* ── Goals ── */
  .goal-visual { position: relative; border-radius: 20px; overflow: hidden; aspect-ratio: 4/3; border: 1px solid var(--border); }
  .goal-visual img { width: 100%; height: 100%; object-fit: cover; }
  .goal-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(0,0,0,0.15), rgba(0,0,0,0.45)); }
  .goal-stat-box {
    position: absolute; bottom: 20px; right: 20px;
    background: rgba(184,119,22,0.90); border-radius: 12px; padding: 0.75rem 1.25rem;
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    backdrop-filter: blur(8px);
  }
  .gsb-val { font-size: 1.5rem; font-weight: 800; color: #0d0e11; line-height: 1; }
